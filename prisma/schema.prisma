generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CompletedStory {
  id          String   @id @default(cuid())
  userId      String
  storySlug   String
  level       String
  completedAt DateTime @default(now())
  chapter     Int      @default(1)
  page        Int      @default(1)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug, level, chapter, page])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, expiresAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionLog {
  id        String   @id @default(cuid())
  userId    String
  ms        Int
  type      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoryBookmark {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  level     String
  chapter   Int
  page      Int
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug])
  @@index([userId])
}

model PageVisit {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  level     String
  chapter   Int
  page      Int
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug, level, chapter, page])
  @@index([userId])
}

model StoryTutorMessage {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  role      String
  content   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, storySlug, createdAt])
}

model TutorMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SavedWord {
  id             String      @id @default(cuid())
  userId         String
  word           String      // Spanish word or phrase
  translation    String      // English translation
  sourceSentence String?     // Context sentence where it was saved
  storySlug      String?     // Which story it came from
  easeFactor     Float       @default(2.5)  // SM-2 ease factor (min 1.3)
  interval       Int         @default(0)    // Days until next review
  repetitions    Int         @default(0)    // Successful review count
  nextReviewDate DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  User           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReviewLog      ReviewLog[]

  @@unique([userId, word])
  @@index([userId, nextReviewDate])
  @@index([userId])
}

model ReviewLog {
  id             String    @id @default(cuid())
  savedWordId    String
  userId         String
  quality        Int       // 0-5 SM-2 quality rating
  direction      String    // "es-en" or "en-es"
  prevInterval   Int
  prevEaseFactor Float
  newInterval    Int
  newEaseFactor  Float
  reviewedAt     DateTime  @default(now())
  SavedWord      SavedWord @relation(fields: [savedWordId], references: [id], onDelete: Cascade)
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([savedWordId])
}

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  nativeLanguage    String?
  quizLevel         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  isPremium         Boolean             @default(false)
  stripeCustomerId  String?             @unique
  Account           Account[]
  CompletedStory    CompletedStory[]
  PageVisit         PageVisit[]
  ReviewLog         ReviewLog[]
  SavedWord         SavedWord[]
  Session           Session[]
  SessionLog        SessionLog[]
  StoryBookmark     StoryBookmark[]
  StoryTutorMessage StoryTutorMessage[]
  TutorMessage      TutorMessage[]
  UserStory         UserStory[]
  UserStoryBookmark UserStoryBookmark[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserStory {
  id                String              @id
  userId            String
  slug              String
  title             String
  titleEs           String?
  titleEn           String?
  description       String?
  descriptionEs     String?
  descriptionEn     String?
  sourceLanguage    String
  detectedLevel     String?
  thumbnailUrl      String?
  status            UserStoryStatus     @default(PROCESSING)
  visibility        StoryVisibility     @default(PRIVATE)
  rawContent        String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserStoryBookmark UserStoryBookmark[]
  UserStoryLevel    UserStoryLevel[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model UserStoryBookmark {
  id          String    @id
  userId      String
  userStoryId String
  level       String
  chapter     Int
  page        Int
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@unique([userId, userStoryId])
  @@index([userId])
}

model UserStoryLevel {
  id                 String      @id
  userStoryId        String
  level              String
  content            Json
  status             LevelStatus @default(PENDING)
  processingProgress Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime
  UserStory          UserStory   @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@unique([userStoryId, level])
  @@index([userStoryId])
}

enum LevelStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum StoryVisibility {
  PRIVATE
  SUBMITTED
  PUBLIC
  REJECTED
}

enum UserStoryStatus {
  PROCESSING
  READY
  FAILED
  PARTIAL
}
