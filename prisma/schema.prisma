generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CompletedStory {
  id          String   @id @default(cuid())
  userId      String
  storySlug   String
  level       String
  completedAt DateTime @default(now())
  chapter     Int      @default(1)
  page        Int      @default(1)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug, level, chapter, page])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, expiresAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionLog {
  id        String   @id @default(cuid())
  userId    String
  ms        Int
  type      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoryBookmark {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  level     String
  chapter   Int
  page      Int
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug])
  @@index([userId])
}

model PageVisit {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  level     String
  chapter   Int
  page      Int
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug, level, chapter, page])
  @@index([userId])
}

model StoryTutorMessage {
  id        String   @id @default(cuid())
  userId    String
  storySlug String
  role      String
  content   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, storySlug, createdAt])
}

model TutorMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  nativeLanguage    String?
  quizLevel         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isPremium         Boolean             @default(false)
  stripeCustomerId  String?             @unique
  Account           Account[]
  ApiCost           ApiCost[]
  CompletedStory    CompletedStory[]
  DeletedUserStory  DeletedUserStory[]
  PageVisit         PageVisit[]
  Session           Session[]
  SessionLog        SessionLog[]
  StoryBookmark     StoryBookmark[]
  StoryTutorMessage StoryTutorMessage[]
  TutorMessage      TutorMessage[]
  UserStory         UserStory[]
  UserStoryBookmark UserStoryBookmark[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserStory {
  id                String              @id
  userId            String
  slug              String
  title             String
  titleEs           String?
  titleEn           String?
  description       String?
  descriptionEs     String?
  descriptionEn     String?
  sourceLanguage    String
  detectedLevel     String?
  thumbnailUrl      String?
  storyType         String?
  targetAudience    String?
  tags              String[]
  hook              String?
  hookEs            String?
  hookEn            String?
  status            UserStoryStatus     @default(PROCESSING)
  processingProgress Json?
  visibility        StoryVisibility     @default(PRIVATE)
  processingMode    String?             // "original_only" | "rewritten_only" | "both"
  rawContent        String
  cancelledAt       DateTime?           // Set when user cancels upload - pipeline checks this before each chapter
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  ApiCost           ApiCost[]
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserStoryBookmark UserStoryBookmark[]
  UserStoryLevel    UserStoryLevel[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model UserStoryBookmark {
  id          String    @id
  userId      String
  userStoryId String
  level       String
  chapter     Int
  page        Int
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@unique([userId, userStoryId])
  @@index([userId])
}

model UserStoryLevel {
  id                 String      @id
  userStoryId        String
  level              String
  content            Json
  status             LevelStatus @default(PENDING)
  processingProgress Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime
  UserStory          UserStory   @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@unique([userStoryId, level])
  @@index([userStoryId])
}

enum LevelStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum StoryVisibility {
  PRIVATE
  SUBMITTED
  PUBLIC
  REJECTED
}

enum UserStoryStatus {
  PROCESSING
  READY
  FAILED
  PARTIAL
  CANCELLED
}

// ============================================================================
// API COST TRACKING
// ============================================================================

model ApiCost {
  id            String    @id @default(cuid())

  // What operation was performed
  operation     String    // e.g., "detection", "rewriting", "translation", "tutor", "thumbnail"

  // Provider and model info
  provider      String    // "openai", "anthropic", "azure"
  model         String    // "gpt-4o", "gpt-4o-mini", "claude-haiku-4-5", "dall-e-3", etc.

  // Token usage (for LLM calls)
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)

  // Image count (for DALL-E calls)
  imageCount    Int       @default(0)

  // Calculated cost in USD (stored as cents for precision)
  costCents     Int       // Cost in cents (e.g., 150 = $1.50)

  // Optional associations
  userId        String?   // User who triggered the call (null for admin/system)
  userStoryId   String?   // Associated user story (if applicable)

  // Additional context
  metadata      Json?     // Extra info like chapter number, level, etc.

  // Timestamps
  createdAt     DateTime  @default(now())

  // Relations
  User          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  UserStory     UserStory? @relation(fields: [userStoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userStoryId])
  @@index([operation])
  @@index([createdAt])
  @@index([provider, model])
}

// ============================================================================
// DELETED USER STORY TRACKING
// Tracks deleted stories so we can maintain accurate cost analytics
// ============================================================================

model DeletedUserStory {
  id              String   @id @default(cuid())
  userId          String
  originalStoryId String   // The original UserStory.id before deletion
  costCents       Int      // Total API cost for this story
  deletedAt       DateTime @default(now())

  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
