{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npm run dev:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(npm run build:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "WebFetch(domain:portal.azure.com)",
      "Bash(cat:*)",
      "Bash(git log:*)"
    ],
    "deny": []
  }
}
