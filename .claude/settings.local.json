{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npm run dev:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(npm run build:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "WebFetch(domain:portal.azure.com)",
      "Bash(cat:*)",
      "Bash(git log:*)",
      "Bash(npx prisma:*)",
      "Bash(npm info:*)",
      "Bash(dir:*)",
      "Bash(xxd:*)",
      "WebSearch",
      "WebFetch(domain:www.gutenberg.org)",
      "Bash(echo:*)",
      "Bash(pkill:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(timeout 10 npm run dev)",
      "Bash(if [ -f .env ])",
      "Bash(then grep -E \"^DATABASE_URL\" .env)",
      "Bash(elif [ -f .env.local ])",
      "Bash(then grep -E \"^DATABASE_URL\" .env.local)",
      "Bash(else echo \"No .env or .env.local found\")",
      "Bash(fi)"
    ],
    "deny": []
  }
}
